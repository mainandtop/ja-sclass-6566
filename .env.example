# ===== Gmail 메일 발송 환경변수 =====
# Vercel > 프로젝트 > Settings > Environment Variables 에 동일하게 등록하세요.

# 발송용 Gmail 주소
EMAIL_USER=yourid@gmail.com

# Gmail "앱 비밀번호" 16자리 (일반 비밀번호 아님!)
#  → Google 계정 > 보안 > 2단계 인증 활성화 > 앱 비밀번호에서 발급
EMAIL_PASS=xxxxxxxxxxxxxxxx

# 수신 이메일 — 콤마(,)로 여러 개 지정 가능 (여기만 늘리면 수신자 추가됨)
RECEIVER_EMAILS=momoseya55@gmail.com

# 메일 제목/본문에 표기될 사이트명
SITE_NAME=부산 장안지구 중흥S-클래스
